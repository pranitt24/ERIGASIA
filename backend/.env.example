# Copy to .env (never commit .env)
DATABASE_URL=sqlite:///./ergasia.db
JWT_SECRET=change-me-before-demo
UPLOAD_DIR=./uploads

# Which implementation each ML component uses: mock | real
# Flip them one at a time as the ML side finishes each piece.
PIPELINE=mock
RETRIEVER_IMPL=mock
GENERATOR_IMPL=mock
GRADER_IMPL=mock
KB_IMPL=mock

# fallback = built-in simple BKT.  ergasia = your mastery/ package (see app/services/mastery_ergasia.py)
MASTERY_BACKEND=fallback

# Seconds each mock step pretends to take, so the UI's "generating..." states are visible
MOCK_STEP_DELAY=1.2
# A question counts as "correct" for BKT when score/max is at least this
BKT_CORRECT_THRESHOLD=0.6
